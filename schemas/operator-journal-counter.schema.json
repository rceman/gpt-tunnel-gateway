{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rceman.github.io/gpt-tunnel-gateway/operator-journal-counter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "next_event_number"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "next_event_number": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}

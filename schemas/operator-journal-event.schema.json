{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rceman.github.io/gpt-tunnel-gateway/operator-journal-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "session_id", "kind", "summary", "content", "references", "actor", "occurred_at", "recorded_at"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 8, "maxLength": 23, "pattern": "^[A-Z]{3}-(OPR|JRN)([1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|9007199254740990|9007199254740991)$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "session_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "kind": {"type": "string", "enum": ["user_talk", "reasoning_summary", "task_plan", "task_review", "operation", "checkpoint", "correction"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
    "content": {"$ref": "#/$defs/content"},
    "references": {"$ref": "#/$defs/references"},
    "supersedes_event_id": {"type": "string", "minLength": 8, "maxLength": 23, "pattern": "^[A-Z]{3}-(OPR|JRN)([1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|9007199254740990|9007199254740991)$"},
    "actor": {"type": "string", "minLength": 1, "maxLength": 256},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "anyOf": [
    {"properties": {"content": {"anyOf": [
      {"properties": {"decisions": {"minItems": 1}}},
      {"properties": {"commitments": {"minItems": 1}}},
      {"properties": {"facts": {"minItems": 1}}},
      {"properties": {"assumptions": {"minItems": 1}}},
      {"properties": {"blockers": {"minItems": 1}}},
      {"properties": {"unresolved": {"minItems": 1}}},
      {"properties": {"next_actions": {"minItems": 1}}}
    ]}}},
    {"properties": {"references": {"anyOf": [
      {"properties": {"plan_sections": {"minItems": 1}}},
      {"properties": {"adrs": {"minItems": 1}}},
      {"properties": {"tasks": {"minItems": 1}}},
      {"properties": {"runs": {"minItems": 1}}},
      {"properties": {"commits": {"minItems": 1}}},
      {"properties": {"identities": {"minItems": 1}}}
    ]}}}
  ],
  "allOf": [
    {"if": {"properties": {"kind": {"const": "correction"}}, "required": ["kind"]}, "then": {"required": ["supersedes_event_id"]}},
    {"if": {"required": ["supersedes_event_id"]}, "then": {"properties": {"kind": {"const": "correction"}}}}
  ],
  "$defs": {
    "bounded_entries": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["decisions", "commitments", "facts", "assumptions", "blockers", "unresolved", "next_actions"],
      "properties": {
        "decisions": {"$ref": "#/$defs/bounded_entries"}, "commitments": {"$ref": "#/$defs/bounded_entries"},
        "facts": {"$ref": "#/$defs/bounded_entries"}, "assumptions": {"$ref": "#/$defs/bounded_entries"},
        "blockers": {"$ref": "#/$defs/bounded_entries"}, "unresolved": {"$ref": "#/$defs/bounded_entries"},
        "next_actions": {"$ref": "#/$defs/bounded_entries"}
      }
    },
    "references": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_sections", "adrs", "tasks", "runs", "commits", "identities"],
      "properties": {
        "plan_sections": {"$ref": "#/$defs/plan_section_ids"}, "adrs": {"$ref": "#/$defs/adr_ids"},
        "tasks": {"$ref": "#/$defs/object_ids"}, "runs": {"$ref": "#/$defs/object_ids"},
        "commits": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}$"}},
        "identities": {"$ref": "#/$defs/bounded_entries"}
      }
    },
    "object_ids": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},
    "plan_section_ids": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},
    "adr_ids": {"type": "array", "maxItems": 128, "items": {"anyOf": [
      {"type": "string", "minLength": 5, "maxLength": 68, "pattern": "^ADR-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
      {"type": "string", "minLength": 8, "maxLength": 23, "pattern": "^[A-Z]{3}-ADR([1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|9007199254740990|9007199254740991)$"}
    ]}}
  }
}

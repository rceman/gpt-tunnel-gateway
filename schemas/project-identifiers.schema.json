{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rceman.github.io/gpt-tunnel-gateway/project-identifiers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_code",
    "next_task_number",
    "next_adr_number"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "project_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "next_task_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "next_adr_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}

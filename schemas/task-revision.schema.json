{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "task_id", "task_revision", "revision_sha256", "project_id", "title", "objective", "branch", "base_revision", "acceptance_criteria", "constraints", "status", "created_by", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Z]{3}-TSK[1-9][0-9]*\\.REV[1-9][0-9]*$"},
    "task_id": {"type": "string", "pattern": "^[A-Z]{3}-TSK[1-9][0-9]*$"},
    "task_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "revision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_task_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "parent_task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 300},
    "objective": {"type": "string", "minLength": 3, "maxLength": 200000},
    "branch": {"type": "string", "pattern": "^task/[A-Z]{3}-TSK[1-9][0-9]*-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "acceptance_criteria": {"type": "array", "maxItems": 200, "items": {"type": "string", "maxLength": 20000}},
    "constraints": {"type": "array", "maxItems": 200, "items": {"type": "string", "maxLength": 20000}},
    "required_gates": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 20000}},
    "workflow_policy_revision": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "operation_class": {"type": "string"},
    "effective_ci_field": {"type": "string"},
    "effective_ci_mode": {"type": "string"},
    "wait_for_ci": {"type": "boolean"},
    "ci_blocking": {"type": "boolean"},
    "agent_may_wait": {"type": "boolean"},
    "status": {"const": "created"},
    "source_run_id": {"type": "string"},
    "source_report_id": {"type": "string"},
    "created_by": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}

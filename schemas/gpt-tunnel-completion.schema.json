{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_sha256", "status", "summary", "gate_results", "acceptance_coverage", "deviations", "remaining_risks"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 13, "maxLength": 80, "pattern": "^[A-Z]{3}-TSK([1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|9007199254740990|9007199254740991)(?:\\.REV([1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|9007199254740990|9007199254740991))?-RUN([1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|9007199254740990|9007199254740991)$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "task_revision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_run_number": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "status": {"enum": ["succeeded", "failed", "needs_gpt_revision"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
    "gate_results": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["id", "exit_code"], "properties": {"id": {"type": "string", "pattern": "^G[1-9][0-9]*$"}, "exit_code": {"type": "integer"}}}},
    "acceptance_coverage": {"type": "array", "maxItems": 128, "items": {"type": "string", "pattern": "^AC[1-9][0-9]*$"}},
    "deviations": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "remaining_risks": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2048}}
  }
}

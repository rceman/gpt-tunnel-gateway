{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rceman.github.io/gpt-tunnel-gateway/task-run-counter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "task_id", "next_run_number"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "task_id": {"type": "string", "minLength": 8, "maxLength": 23, "pattern": "^[A-Z]{3}-TSK([1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|9007199254740990|9007199254740991)$"},
    "next_run_number": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}

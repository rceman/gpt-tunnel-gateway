{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "task_id", "task_sha256", "project_id", "gateway_id", "session_key", "branch", "base_revision", "hub_revision", "status", "completion_path", "created_at"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string"}, "task_id": {"type": "string"}, "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "project_id": {"type": "string"}, "gateway_id": {"type": "string"}, "session_key": {"type": "string"}, "branch": {"type": "string"}, "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "hub_revision": {"type": "string"},
    "status": {"enum": ["created", "dispatching", "dispatched", "awaiting_result", "cancel_requested", "succeeded", "failed", "needs_gpt_revision"]}, "dispatch_message": {"type": "string", "maxLength": 512}, "dispatch_exit_code": {"type": "integer"}, "dispatch_stdout": {"type": "string"}, "dispatch_stderr": {"type": "string"}, "completion_path": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "dispatched_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"}, "reprompt_count": {"type": "integer", "minimum": 0}, "last_reprompt_at": {"type": "string", "format": "date-time"}
  }
}
